FROM python:3.10-slim
ENV PYTHONUNBUFFERED=1 
WORKDIR /app

# NEW: Install OS-level MIME types so Python's mimetypes library works dynamically
RUN apt-get update && \
    (apt-get install -y media-types || apt-get install -y mime-support) && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY azure_etl_pipeline.py .
CMD ["python", "azure_etl_pipeline.py"]